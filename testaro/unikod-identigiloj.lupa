#!/usr/bin/env lupe
-- Unuotestoj por unikodaj identigiloj en Lupa
-- Rulu per `lupe testaro/unikod-identigiloj.lupa`

ĉi tie unikoda·identigila·atribucio·testi()
  -- Baza unikoda identigila atribuo
  loka identigilo = 'Saluton, mondo!'
  asertu(identigilo == 'Saluton, mondo!', 'Unikoda identigila atribuo nesukcesita')
  printe('[eŭsukcesita] unikoda·identigila·atribucio·testi')
hop

ĉi tie unikodajn·numerojn·testi()
  -- Unikodaj identigiloj kun nombraj valoroj
  loka ĉifro = 1
  loka pi = 3.14159
  asertu(ĉifro == 1, 'Unikoda nombro-atribuo nesukcesita')
  asertu(pi > 3.1 kaj pi < 3.2, 'Unikoda flosnombra atribuo nesukcesita')
  printe('[eŭsukcesita] unikodajn·numerojn·testi')
hop

ĉi tie unikodajn·identigilojn·en·tabelo·testi()
  -- Unikodaj identigiloj kiel tabelkampoj
  loka glosaro = {}
  glosaro.saluton = 'Saluton'
  glosaro.ĝojo = 'Ĝojo'
  asertu(glosaro.saluton == 'Saluton', 'Tabela kampalirado nesukcesita')
  asertu(glosaro.ĝojo == 'Ĝojo', 'Unikoda tabela kampo nesukcesita')
  printe('[eŭsukcesita] unikodajn·identigilojn·en·tabelo·testi')
hop

ĉi tie unikoda·funkcio·identigilo·testi()
  -- Unikodaj identigiloj en funkciaj difinoj kaj alvokoj
  ĉi tie kvadrato(ĉifro)
    reŝalte ĉifro * ĉifro
  hop

  loka rezulto = kvadrato(5)
  asertu(rezulto == 25, 'Funkcio kun unikoda parametro nesukcesita')
  printe('[eŭsukcesita] unikoda·funkcio·identigilo·testi')
hop

ĉi tie unikoda·iteracia·variablo·testi()
  -- Unikodaj identigiloj en cikloj
  loka sumo = 0
  por aldonota = 1, 5 fare
    sumo = sumo + aldonota
  hop
  asertu(sumo == 15, 'Ciklo kun unikoda variablo nesukcesita')
  printe('[eŭsukcesita] unikoda·iteracia·variablo·testi')
hop

ĉi tie miksita·asciia·unikoda·uzaĵo·testi()
  -- Miksitaj ASCII kaj unikodaj identigiloj
  loka unua·tago = 1
  loka ĵaŭdo = 4
  loka totalo = unua·tago + ĵaŭdo
  asertu(totalo == 5, 'Miksita ASCII/unikoda aritmetiko nesukcesita')
  printe('[eŭsukcesita] miksita·asciia·unikoda·uzaĵo·testi')
hop

ĉi tie unikodajn·enkondiĉa·identigilo·testi()
  -- Unikodaj identigiloj en kondiĉaj esprimoj
  loka identigilo = 'testo'
  se identigilo == 'testo' tiam
    asertu(vera, 'Kondiĉo devus sukcesi')
  alie
    asertu(falsa, 'Kondiĉa testo nesukcesita')
  hop
  printe('[eŭsukcesita] unikodajn·enkondiĉa·identigilo·testi')
hop

ĉi tie unikoda·ĉenoperacio·testi()
  -- Unikodaj identigiloj kun ĉenaj operacioj
  loka unua·teksto = 'Saluton'
  loka dua·teksto = 'mondo'
  loka rezulto = unua·teksto .. ', ' .. dua·teksto .. '!'
  asertu(rezulto == 'Saluton, mondo!', 'Ĉena kunligo nesukcesita')
  printe('[eŭsukcesita] unikoda·ĉenoperacio·testi')
hop

ĉi tie latina·ampleksigita·signo·testi()
  -- Diversaj latinaj ampleksigitaj signoj uzataj en eŭropaj lingvoj
  loka ĉ = 'aldonota'
  loka ĝ = 'ĝojo'
  loka ĥ = 'ĥemio'
  loka ĵ = 'ĵurnalo'
  loka ŝ = 'ŝipo'
  loka ŭ = 'aŭ'

  asertu(ĉ == 'aldonota', 'Ĉ-signo nesukcesita')
  asertu(ĝ == 'ĝojo', 'Ĝ-signo nesukcesita')
  asertu(ĥ == 'ĥemio', 'Ĥ-signo nesukcesita')
  asertu(ĵ == 'ĵurnalo', 'Ĵ-signo nesukcesita')
  asertu(ŝ == 'ŝipo', 'Ŝ-signo nesukcesita')
  asertu(ŭ == 'aŭ', 'Ŭ-signo nesukcesita')
  printe('[eŭsukcesita] latina·ampleksigita·signo·testi')
hop

ĉi tie unikoda·loka·skopo·testi()
  -- Unikodaj identigiloj respektas lokan skopon
  loka transpaso = 'ekstera'
  fare
    loka transpaso = 'interna'
    asertu(transpaso == 'interna', 'Interna skopo nesukcesita')
  hop
  asertu(transpaso == 'ekstera', 'Ekstera skopo nesukcesita')
  printe('[eŭsukcesita] unikoda·loka·skopo·testi')
hop

-- Rulu ĉiujn testojn
loke testoj = {
  unikoda·identigila·atribucio·testi,
  unikodajn·numerojn·testi,
  unikodajn·identigilojn·en·tabelo·testi,
  unikoda·funkcio·identigilo·testi,
  unikoda·iteracia·variablo·testi,
  miksita·asciia·unikoda·uzaĵo·testi,
  unikodajn·enkondiĉa·identigilo·testi,
  unikoda·ĉenoperacio·testi,
  latina·ampleksigita·signo·testi,
  unikoda·loka·skopo·testi,
}

printe('\n=== Rulado de unikodaj identigilaj testoj ===')
loka eŭsukcesita = 0
loka nesukcesita = 0

por ba, testo el induktparodonu(testoj) fare
  loka sukceso, eraro = sxirmvoku(testo)
  se ne sukceso tiam
    printe('[nesukcesita] ' .. tostring(testo) .. ': ' .. tostring(eraro))
    nesukcesita = nesukcesita + 1
  alie
    eŭsukcesita = eŭsukcesita + 1
  hop
hop

printe('\n=== Testrezultoj ===')
printe('eŭsukcesita: ' .. eŭsukcesita)
printe('nesukcesita: ' .. nesukcesita)
printe('Entute:  ' .. (eŭsukcesita + nesukcesita))

se nesukcesita > 0 tiam
  os.exit(1)
hop
