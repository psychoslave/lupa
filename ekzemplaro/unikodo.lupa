-- Testo de unikodaj identigiloj en Lupa
-- Tiu dosiero testas subtenon por UTF-8-koditaj unikodaj signoj en identigiloj

-- Esperanto-identigiloj kun ĉapelitaj literoj
mesaĝo = 'Saluton, mondo!'
ĉifro = 42
selfero = 3.14

-- Testo 1: simpla atribuo de unikodaj identigiloj kaj elskribo
printe(mesaĝo)
printe(ĉifro)
printe(selfero)

-- Testo 2: unikodaj identigiloj en tabelo
lupa_vorto = {
  saluton = 'Ĥej',
  adiaŭo = 'Ĝis'
}
printe(lupa_vorto.saluton)
printe(lupa_vorto.adiaŭo)

-- Testo 3: unikodaj identigiloj en funkcioj
ĉi tie eltrovo_kvadrato(nombro)
  reŝalte nombro * nombro
hop

rezultato = eltrovo_kvadrato(5)
printe(rezultato)

-- Testo 4: unikodo en iteraciaj variabloj
por ĉapelo = 1, 3 fare
  printe(ĉapelo)
hop

-- Testo 5: miksitaj ASCII kaj unikodo en sama kunteksto de identigiloj
aso = 1
ĵaŭdo = 2
vendrudo = 3
printe(aso .. ', ' .. ĵaŭdo .. ', ' .. vendrudo)

-- Testo 6: unikoda variablo en kondiĉoj
se mesaĝo samas 'Saluton, mondo!' tiam
  printe('Unikodaj identigiloj laboras!')
hop

printe('Ĉiuj testoj finiĝis.')
